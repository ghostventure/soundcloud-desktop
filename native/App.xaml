<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Soundcloud Desktop" Width="1160" Height="840" MinWidth="900" MinHeight="680" Background="#191A1D" Foreground="#F4F4F5" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <SolidColorBrush x:Key="Accent" Color="#FF692B"/>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#202124"/><Setter Property="Foreground" Value="#F4F4F5"/><Setter Property="CaretBrush" Value="#FF793F"/><Setter Property="BorderBrush" Value="#45464C"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Background" Value="#202124"/><Setter Property="Foreground" Value="#F4F4F5"/><Setter Property="BorderBrush" Value="#45464C"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F4F5"/><Setter Property="Background" Value="#303136"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#45464C" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFA57A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="#202124"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#202124"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="#202124"/><Setter Property="Foreground" Value="#F4F4F5"/><Setter Property="BorderBrush" Value="#393A3E"/><Setter Property="Padding" Value="7"/></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E5E8"/><Setter Property="Margin" Value="0,7"/></Style>
 <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
 <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="#ABACB6"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,24"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#27282C"/><Setter Property="BorderBrush" Value="#393A3E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
</Window.Resources>
<Grid>
<Grid Name="WorkspaceShell"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <DockPanel Grid.Column="0" Margin="14,24,14,12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="▥  Soundcloud Desktop" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,8"/><TextBlock Text="ARTIST WORKSPACE" Foreground="#FF945F" FontSize="10" Margin="6,0,0,30"/><Button Name="NavUpload" Style="{StaticResource Nav}" Content="↑   Upload music"/><Button Name="NavLibrary" Style="{StaticResource Nav}" Content="♫   Music library"/><Button Name="NavReleases" Style="{StaticResource Nav}" Content="◷   Releases"/><Button Name="NavPromotion" Style="{StaticResource Nav}" Content="↗   Promotion"/><TextBlock Text="CONNECTED SERVICES" Foreground="#9A9BA7" FontSize="10" Margin="8,26,0,10"/><Button Name="NavStudio" Style="{StaticResource Nav}" Content="Artist Studio"/><Button Name="NavAmplify" Style="{StaticResource Nav}" Content="Amplify"/><Button Name="NavInsights" Style="{StaticResource Nav}" Content="Insights"/><Button Name="NavMonetization" Style="{StaticResource Nav}" Content="Monetization"/><Button Name="NavAccount" Style="{StaticResource Nav}" Content="☁   SoundCloud"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="●  Saved on this PC" Foreground="#ABCAB6" FontSize="11" Margin="10,0,0,16"/><Button Name="NavSettings" Style="{StaticResource Nav}" Content="⚙   Settings"/></StackPanel></DockPanel>
 <Grid Grid.Column="1" Background="#202124"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Name="InfoBar" Background="#493329" CornerRadius="5" Margin="28,18,28,0" Padding="14" Visibility="Collapsed"><TextBlock Name="Info" TextWrapping="Wrap"/></Border>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,20"><Grid>
 <StackPanel Name="UploadPage"><TextBlock Text="From your studio. To your SoundCloud." Style="{StaticResource H1}"/><TextBlock Text="Choose your master, add the details, and upload directly to your artist account." Style="{StaticResource Sub}"/>
 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="01  /  YOUR AUDIO" Foreground="#FF945F" FontSize="11" Margin="0,0,0,16"/><TextBlock Name="AccountBadge" Text="Not connected" Foreground="#ABACB6" HorizontalAlignment="Right"/></DockPanel><Button Name="ChooseAudio" Content="＋  Choose audio file" Background="#E8551B" HorizontalAlignment="Left"/><TextBlock Name="AudioName" Text="Or drag an audio file into this window" Foreground="#ABACB6" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  /  MAKE IT YOURS" Foreground="#FF945F" FontSize="11" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Track title"/><TextBox Name="TrackTitle" MaxLength="180"/><TextBlock Text="Genre"/><TextBox Name="Genre" MaxLength="150"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Artist name"/><TextBox Name="Artist" MaxLength="180"/><TextBlock Text="Visibility"/><ComboBox Name="VisibilityChoice" SelectedIndex="0"><ComboBoxItem Content="Private — only you and shared links"/><ComboBoxItem Content="Public — visible to everyone"/></ComboBox></StackPanel></Grid><TextBlock Text="Description and credits"/><TextBox Name="Description" AcceptsReturn="True" Height="83" MaxLength="10000" VerticalScrollBarVisibility="Auto"/><DockPanel><Image Name="ArtworkImage" Width="58" Height="58" Stretch="UniformToFill" Margin="0,0,12,0" Visibility="Collapsed"/><StackPanel><Button Name="ChooseArt" Content="Choose cover artwork" HorizontalAlignment="Left"/><TextBlock Name="ArtworkName" Text="Optional · JPG or PNG · up to 10 MB" Foreground="#ABACB6" Margin="0,8,0,0"/></StackPanel></DockPanel></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Name="UploadButton" Content="↑  Upload to SoundCloud" Background="#E8551B" HorizontalAlignment="Left"/><Button Name="CancelUpload" Content="Cancel transfer" Visibility="Collapsed" HorizontalAlignment="Left"/></DockPanel><ProgressBar Name="TransferProgress" Height="5" Margin="0,16,0,10" Maximum="100" Foreground="#FF793F" Background="#393A3E"/><TextBlock Name="UploadHint" Text="Private is selected by default. Public tracks become visible after SoundCloud processes them." Foreground="#ABACB6" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
 <StackPanel Name="LibraryPage" Visibility="Collapsed"><TextBlock Text="Music library" Style="{StaticResource H1}"/><TextBlock Text="Your local audio files and upload history. Original files stay where they are." Style="{StaticResource Sub}"/><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Name="ImportLibrary" Content="＋ Import tracks" Background="#E8551B"/><Button Name="UseTrack" Content="Prepare selected for upload"/><Button Name="RevealTrack" Content="Show in Explorer"/></StackPanel><ListBox Name="TrackList" MinHeight="300"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Name="PreviewTrack" Content="▶ Preview"/><Button Name="PauseTrack" Content="Pause"/><Button Name="RemoveTrack" Content="Remove from library"/></StackPanel><TextBlock Text="Playback depends on the audio codecs installed on this PC. Uploading does not require playback support." Style="{StaticResource Sub}" Margin="0,20,0,0"/></StackPanel>
 <StackPanel Name="ReleasesPage" Visibility="Collapsed"><TextBlock Text="Releases" Style="{StaticResource H1}"/><TextBlock Text="A little structure between the final master and release day." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Release title"/><TextBox Name="ReleaseTitle"/><TextBlock Text="Target date"/><DatePicker Name="ReleaseDate" Margin="0,8,0,16"/><TextBlock Text="Notes and credits"/><TextBox Name="ReleaseNotes" Height="85" AcceptsReturn="True"/><CheckBox Name="MasterDone" Content="Final master approved"/><CheckBox Name="ArtworkDone" Content="Artwork ready"/><CheckBox Name="MetadataDone" Content="Credits and metadata checked"/><CheckBox Name="PublishedDone" Content="Uploaded to SoundCloud"/><Button Name="SaveRelease" Content="Save release plan" Background="#E8551B" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border><ListBox Name="ReleaseList" MinHeight="100"/><TextBlock Text="Release dates are planning dates; they do not schedule publication on SoundCloud." Style="{StaticResource Sub}" Margin="0,16,0,0"/></StackPanel>
 <StackPanel Name="PromotionPage" Visibility="Collapsed"><TextBlock Text="Promotion" Style="{StaticResource H1}"/><TextBlock Text="Give every release a thoughtful introduction." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Campaign title"/><TextBox Name="CampaignTitle"/><TextBlock Text="Contact or channel"/><TextBox Name="CampaignContact"/><TextBlock Text="Caption, pitch, and release link"/><TextBox Name="CampaignText" Height="130" AcceptsReturn="True"/><StackPanel Orientation="Horizontal"><Button Name="SaveCampaign" Content="Save campaign" Background="#E8551B"/><Button Name="CopyCampaign" Content="Copy text"/></StackPanel></StackPanel></Border><ListBox Name="CampaignList" MinHeight="130"/></StackPanel>
 <StackPanel Name="AccountPage" Visibility="Collapsed"><TextBlock Text="Welcome to your studio" Style="{StaticResource H1}"/><TextBlock Text="Sign in to connect your music and artist account." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Name="LoginIdentity" Text="Your credentials stay with the provider." FontSize="19" Margin="0,0,0,12"/><TextBlock Text="Soundcloud Desktop never asks for your SoundCloud, Google, or Apple password. Sign in on SoundCloud's secure authorization page." Style="{StaticResource Sub}"/><StackPanel><Button Name="ConnectAccount" Margin="0,0,0,10" Content="Continue with SoundCloud" Background="#E8551B"/><Button Name="GoogleLogin" Margin="0,0,0,10" Content="Continue with Google"/><Button Name="AppleLogin" Margin="0" Content="Continue with Apple"/></StackPanel><TextBlock Name="ProviderHint" Text="Google and Apple options appear on the official SoundCloud sign-in page when available for your account." Foreground="#ABACB6" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border><Expander Name="DeveloperSetup" Header="Connection setup" Margin="0,0,0,16" Foreground="#D5D5DA"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="One-time developer setup" FontSize="17" Margin="0,0,0,16"/><TextBlock Text="Your Artist Pro plan lets you register an API app. Enter its credentials locally; they are encrypted for this Windows account." Style="{StaticResource Sub}"/><TextBlock Text="Client ID"/><TextBox Name="ClientId"/><TextBlock Text="Client secret"/><PasswordBox Name="ClientSecret"/><TextBlock Text="Register this exact redirect address:" Foreground="#ABACB6"/><TextBox Name="RedirectAddress" Text="http://127.0.0.1:49832/callback" IsReadOnly="True"/><StackPanel Orientation="Horizontal"><Button Name="SaveCredentials" Content="Save credentials"/><Button Name="RegistrationGuide" Content="API setup guide ↗"/></StackPanel><TextBlock Name="ConnectionState" Text="Credentials are encrypted for your Windows account." Foreground="#ABACB6" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></Expander><Expander Header="Having trouble connecting?" Margin="0,0,0,20" Foreground="#D5D5DA"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connecting from another browser or device" FontSize="16" Margin="0,0,0,10"/><TextBlock Text="Copy the authorization link to a current browser. After approving, paste the full localhost callback address here." Style="{StaticResource Sub}"/><Button Name="CopyAuthLink" Content="Copy authorization link" HorizontalAlignment="Left"/><TextBox Name="CallbackAddress" Margin="0,15,0,12"/><Button Name="FinishCallback" Content="Finish connection from pasted address" HorizontalAlignment="Left"/></StackPanel></Border></Expander><StackPanel Name="AccountActions" Orientation="Horizontal"><Button Name="SyncAccount" Content="Verify account again"/><Button Name="DisconnectAccount" Content="Sign out on this PC"/><Button Name="OpenInsights" Content="Artist Insights ↗"/></StackPanel></StackPanel>
 <StackPanel Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="Settings" Style="{StaticResource H1}"/><TextBlock Text="A focused native Windows uploader, with your workspace stored locally." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Hardware permissions" FontSize="17" Margin="0,0,0,12"/><TextBlock Name="HardwareState" Text="Speaker and headphone playback: ask before use." Style="{StaticResource Sub}"/><TextBlock Text="Microphone, camera, and location are not used by this build. Those features have no permission to access your devices." Style="{StaticResource Sub}"/><Button Name="ResetHardware" Content="Reset playback consent — ask next time" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Workspace backup" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="Backups contain plans, campaigns, upload history, and original file paths. Keep a separate copy of your audio and artwork. Credentials are excluded." Style="{StaticResource Sub}"/><StackPanel Orientation="Horizontal"><Button Name="ExportData" Content="Export backup"/><Button Name="ImportData" Content="Restore backup"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compatibility and integrity" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="64-bit Windows Vista SP2, 7 SP1, 8, 10 and 11 are the compatibility targets. Requires .NET Framework 4 or later and Universal CRT. Older systems have not been tested on this PC. The bundled current TLS transport avoids relying on old Windows TLS implementations." Style="{StaticResource Sub}"/><TextBlock Text="One instance per Windows session. Credentials use Windows DPAPI. The network helper and certificate bundle are checked against embedded SHA-256 hashes before requests. Certificate verification remains enabled." Style="{StaticResource Sub}"/><Button Name="CheckNetwork" Content="Test secure SoundCloud connection" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Soundcloud Desktop 0.1.0 · Native compatibility edition&#10;Independent app. Not affiliated with or endorsed by SoundCloud." Style="{StaticResource Sub}"/></StackPanel>
 <StackPanel Name="StudioPage" Visibility="Collapsed"><TextBlock Text="Artist Studio" Style="{StaticResource H1}"/><TextBlock Text="Your SoundCloud artist tools, together in one workspace." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Name="StudioIdentity" Text="Connect and verify your artist account to begin." FontSize="19" Margin="0,0,0,16"/><TextBlock Text="Manage your online catalog, distribution, fans, and artist benefits in SoundCloud for Artists. The official dashboard opens in your browser, where you may need to sign in separately." Style="{StaticResource Sub}"/><StackPanel Orientation="Horizontal"><Button Name="OpenStudio" Content="Open Artist Studio ↗" Background="#E8551B"/><Button Name="OpenOnlineTracks" Content="Manage online tracks ↗"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Create here. Manage your career there." FontSize="19" Margin="0,0,0,14"/><TextBlock Text="Upload audio directly inside this app. Use the official artist dashboard for distribution, Amplify activation, monetization applications, earnings, and account-specific services that are not exposed by SoundCloud's public API." Style="{StaticResource Sub}"/></StackPanel></Border></StackPanel>
 <StackPanel Name="AmplifyPage" Visibility="Collapsed"><TextBlock Text="Amplify" Style="{StaticResource H1}"/><TextBlock Text="Help a new release find listeners who connect with your sound." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Before you opt in" FontSize="19" Margin="0,0,0,16"/><TextBlock Text="SoundCloud currently lists public music tracks longer than 1 minute and shorter than 10 minutes, uploaded or made public within the last 14 days. Artist and Artist Pro subscribers can review eligible tracks in Artist Studio." Style="{StaticResource Sub}"/><TextBlock Text="Select an eligible track in Artist Studio and use its lightning-bolt control to opt in. Recommendations are not guaranteed full listens, followers, or revenue." Style="{StaticResource Sub}"/><StackPanel Orientation="Horizontal"><Button Name="OpenAmplifyStudio" Content="Review tracks in Artist Studio ↗" Background="#E8551B"/><Button Name="AmplifyGuide" Content="Current eligibility guide ↗"/></StackPanel></StackPanel></Border><TextBlock Text="Amplify activation and eligibility are managed by SoundCloud. This page does not automatically enroll tracks." Style="{StaticResource Sub}"/></StackPanel>
 <StackPanel Name="InsightsPage" Visibility="Collapsed"><TextBlock Text="Insights" Style="{StaticResource H1}"/><TextBlock Text="See verified catalog totals and open your detailed audience analytics." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Name="InsightAccount" Text="Connect your account before refreshing statistics." FontSize="18" Margin="0,0,0,20"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="CATALOG TRACKS" Foreground="#ABACB6" FontSize="10"/><TextBlock Name="InsightTracks" Text="—" FontSize="32" Margin="0,8,0,18"/></StackPanel><StackPanel><TextBlock Text="TOTAL PLAYS" Foreground="#ABACB6" FontSize="10"/><TextBlock Name="InsightPlays" Text="—" FontSize="32" Margin="0,8,0,18"/></StackPanel><StackPanel><TextBlock Text="TOTAL LIKES" Foreground="#ABACB6" FontSize="10"/><TextBlock Name="InsightLikes" Text="—" FontSize="32" Margin="0,8,0,18"/></StackPanel></UniformGrid><StackPanel Orientation="Horizontal"><Button Name="RefreshInsights" Content="Refresh from my account" Background="#E8551B"/><Button Name="DetailedInsights" Content="Detailed Artist Insights ↗"/></StackPanel><TextBlock Name="InsightUpdated" Text="No statistics loaded. Values appear only after a successful authenticated refresh." Style="{StaticResource Sub}" Margin="0,18,0,0"/></StackPanel></Border><TextBlock Text="These are totals from tracks returned by the public API, not a date-filtered earnings report. Audience demographics and time-based reports are available in official Artist Insights." Style="{StaticResource Sub}"/></StackPanel>
 <StackPanel Name="MonetizationPage" Visibility="Collapsed"><TextBlock Text="Monetization" Style="{StaticResource H1}"/><TextBlock Text="Understand the steps between uploading music and earning royalties." Style="{StaticResource Sub}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Uploading does not enable monetization" FontSize="19" Margin="0,0,0,16"/><TextBlock Text="Apply for eligible tracks in SoundCloud for Artists. You need the rights to the music you submit and may be asked for licensing evidence. SoundCloud reviews the application; this app cannot approve it." Style="{StaticResource Sub}"/><Button Name="OpenMonetization" Content="Manage track monetization ↗" Background="#E8551B" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Set up your payouts" FontSize="19" Margin="0,0,0,16"/><TextBlock Text="Complete your payout method, tax information, email verification, and required agreement in SoundCloud. Keep banking and tax details on the official dashboard. Earnings depend on actual eligible listening, and there is no guaranteed income." Style="{StaticResource Sub}"/><StackPanel Orientation="Horizontal"><Button Name="OpenEarnings" Content="Earnings and statements ↗"/><Button Name="OpenPayouts" Content="Payout setup ↗"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Official guidance" FontSize="19" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Name="MonetizationGuide" Content="Eligibility and submission ↗"/><Button Name="PayoutGuide" Content="Getting paid ↗"/></StackPanel><TextBlock Text="Guidance checked September 13, 2026. SoundCloud's current terms and your account dashboard determine eligibility and payout details." Style="{StaticResource Sub}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
 </Grid></ScrollViewer></Grid>
 <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#393A3E" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel VerticalAlignment="Center"><TextBlock Name="PlayerLabel" Text="♫  Your next great track" Foreground="#ABACB6"/><TextBlock Text="LOCAL WORKSPACE  /  DIRECT UPLOADS" FontSize="10" Foreground="#FF945F" HorizontalAlignment="Right"/></DockPanel></Border>
</Grid>
<Grid Name="LoginCover" Background="#191A1D">
 <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#25201D" Padding="32,44">
  <Grid><StackPanel VerticalAlignment="Center">
   <TextBlock Text="SOUNDCLOUD DESKTOP" Foreground="#FF793F" FontWeight="Bold" FontSize="16" Margin="0,0,0,36"/>
   <TextBlock Text="Your music.&#10;Your next chapter." FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,22"/>
   <TextBlock Text="A home for your artist workflow." Foreground="#C8BDB6" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,34"/>
   <TextBlock Text="Upload your tracks&#10;Prepare your releases&#10;Explore artist tools" Foreground="#C8BDB6" FontSize="14" LineHeight="30"/>
  </StackPanel><TextBlock VerticalAlignment="Bottom" Text="Independent desktop client for SoundCloud" Foreground="#A99A90" TextWrapping="Wrap" FontSize="12"/></Grid>
 </Border>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="620" Margin="36,38" VerticalAlignment="Center">
   <Border Name="LoginStatusBar" Visibility="Collapsed" Background="#302B27" BorderBrush="#76513D" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20"><StackPanel><TextBlock Name="LoginStatus" TextWrapping="Wrap" Foreground="#FFD2BB"/><ProgressBar Name="LoginProgress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel></Border>
   <ContentControl Name="LoginContent" HorizontalContentAlignment="Stretch"/>
  </StackPanel>
 </ScrollViewer>
</Grid>
</Grid></Window>
