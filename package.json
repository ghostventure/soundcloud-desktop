{
  "name": "soundcloud-desktop",
  "productName": "SC-DS",
  "version": "1.0.0",
  "description": "An independent Windows workspace by Black Lion Studios",
  "author": "Black Lion Studios",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.cjs",
    "catalog:build": "node scripts/generate-installer-catalog.cjs",
    "dist": "npm run catalog:build && electron-builder --win nsis --x64",
    "dist:installer": "npm run catalog:build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.63.0"
  },
  "build": {
    "appId": "com.soundclouddesktop.artist",
    "productName": "SC-DS",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "connection.cjs",
      "upload.cjs",
      "ui/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "docs/PRIVACY-AND-LICENSES.md",
        "to": "PRIVACY-AND-LICENSES.md"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "forceCodeSigning": true,
      "certificateSubjectName": "Black Lion Studios",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SC-DS Installation Manager-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
